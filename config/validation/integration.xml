<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping
    http://symfony.com/schema/dic/constraint-mapping/constraint-mapping-1.0.xsd">

    <class name="BitBag\SyliusErgonodePlugin\Entity\Integration">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">
                <value>apiUrl</value>
                <value>categoryTreeCode</value>
            </option>
            <option name="groups">
                <value>sylius</value>
            </option>
            <option name="message">bitbag_ergonode.integration.duplicated_for_url_and_category_tree</option>
        </constraint>
        <constraint name="BitBag\SyliusErgonodePlugin\Validator\Constraint\ErgonodeIntegrationConstraint">
            <option name="groups">
                <value>sylius</value>
            </option>
        </constraint>

        <property name="name">
            <constraint name="NotBlank">
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
        </property>
        <property name="apiKey">
            <constraint name="NotBlank">
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
        </property>
        <property name="apiUrl">
            <constraint name="NotBlank">
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
            <constraint name="Url">
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
        </property>
        <property name="categoryTreeCode">
            <constraint name="NotBlank">
                <option name="groups">
                    <value>sylius</value>
                </option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
