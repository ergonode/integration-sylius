<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag.sylius_ergonode_plugin.manager.product.product_association_synchronization_manager" class="BitBag\SyliusErgonodePlugin\Manager\Product\ProductAssociationSynchronizationManager">
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.mapped_products_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.storage.products_relations_storage"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.product_association_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.manager.product.product_deleted_synchronization_manager" class="BitBag\SyliusErgonodePlugin\Manager\Product\ProductDeletedSynchronizationManager">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.collector.deleted_products_collector"/>
            <argument type="service" id="sylius.repository.product"/>
            <argument type="service" id="sylius.repository.product_variant"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.manager.product.product_synchronization_manager" class="BitBag\SyliusErgonodePlugin\Manager\Product\ProductSynchronizationManager">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.product_api_client"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.product_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.storage.variant_codes_storage"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product.product_values_assigner"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product.product_taxons_assigner"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.manager.product.product_variants_synchronization_manager" class="BitBag\SyliusErgonodePlugin\Manager\Product\ProductVariantsSynchronizationManager">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product_variant.product_variant_values_assigner"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.product_option_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.product_variant_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.storage.variant_codes_storage"/>
            <argument type="service" id="sylius.repository.product"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
        </service>
    </services>
</container>
