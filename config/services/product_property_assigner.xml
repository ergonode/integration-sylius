<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults>
            <tag name="bitbag.sylius_ergonode_plugin.product_property_assigner"/>
        </defaults>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.channels_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\ChannelsValueAssigner">
            <argument type="service" id="sylius.repository.channel"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.current_stock_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\CurrentStockValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.float_value_resolver"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.depth_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\DepthValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.product_variant_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.float_value_resolver"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.description_value_assigner_translatable" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\DescriptionValueAssignerTranslatable">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.value.text_value_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.translation.product_translation_assigner"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.height_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\HeightValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.product_variant_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.float_value_resolver"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.main_taxon_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\MainTaxonValueAssigner">
            <argument type="service" id="sylius.repository.taxon"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.meta_description_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\MetaDescriptionValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.value.text_value_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.translation.product_translation_assigner"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.meta_keywords_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\MetaKeywordsValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.value.text_value_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.translation.product_translation_assigner"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.name_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\NameValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.value.text_value_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.translation.product_translation_assigner"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.price_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\PriceValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.product_variant_resolver"/>
            <argument type="service" id="sylius.repository.channel"/>
            <argument type="service" id="sylius.factory.channel_pricing"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.converter.money_converter"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.shipping_category_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\ShippingCategoryValueAssigner">
            <argument type="service" id="sylius.repository.shipping_category"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.product_variant_resolver"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.shipping_required_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\ShippingRequiredValueAssigner"/>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.short_description_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\ShortDescriptionValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.value.text_value_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.translation.product_translation_assigner"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.slug_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\SlugValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.value.text_value_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.translation.product_translation_assigner"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.tax_category_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\TaxCategoryValueAssigner">
            <argument type="service" id="sylius.repository.tax_category"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.product_variant_resolver"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.tracked_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\TrackedValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.product_variant_resolver"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.product.width_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Product\WidthValueAssigner">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.product_variant_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.float_value_resolver"/>
        </service>
    </services>
</container>
