<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>

    <services>
        <service id="bitbag.sylius_ergonode_plugin.collector.deleted_attributes_collector" class="BitBag\SyliusErgonodePlugin\Collector\DeletedAttributesCollector">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.attribute_api_client"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.collector.deleted_categories_collector" class="BitBag\SyliusErgonodePlugin\Collector\DeletedCategoriesCollector">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.category_api_client"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.collector.deleted_products_collector" class="BitBag\SyliusErgonodePlugin\Collector\DeletedProductsCollector">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.product_api_client"/>
        </service>
    </services>
</container>
