<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag.sylius_ergonode_plugin.storage.variant_codes_storage" class="BitBag\SyliusErgonodePlugin\Storage\VariantCodesStorage">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.variant_api_client"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.storage.products_relations_storage" class="BitBag\SyliusErgonodePlugin\Storage\ProductsRelationsStorage"/>
        <service id="bitbag.sylius_ergonode_plugin.storage.product_association_type_storage" class="BitBag\SyliusErgonodePlugin\Storage\ProductAssociationTypeStorage">
            <argument type="service" id="sylius.repository.product_association_type"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.storage.taxon_storage" class="BitBag\SyliusErgonodePlugin\Storage\TaxonStorage">
            <argument type="service" id="sylius.repository.taxon"/>
        </service>
    </services>
</container>
