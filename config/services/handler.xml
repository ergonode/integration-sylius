<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag.sylius_ergonode_plugin.handler.synchronization_handler" class="BitBag\SyliusErgonodePlugin\Handler\SynchronizationHandler">
            <argument type="tagged_iterator" tag="bitbag.sylius_ergonode_plugin.synchronizer"/>
            <argument type="service" id="bitbag_ergonode.repository.integration"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.context.full_synchronization_context"/>
            <tag name="messenger.message_handler"/>
        </service>
    </services>
</container>
