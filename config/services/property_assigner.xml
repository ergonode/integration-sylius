<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <defaults>
            <tag name="bitbag.sylius_ergonode_plugin.product_property_assigner"/>
            <tag name="bitbag.sylius_ergonode_plugin.product_variant_property_assigner"/>
        </defaults>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.common.media_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Common\MediaAssigner">
            <argument type="service" id="sylius.factory.product_image"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.downloader.ergonode_file_downloader"/>
        </service>
        <service id="bitbag.sylius_ergonode_plugin.assigner.property.common.enabled_value_assigner" class="BitBag\SyliusErgonodePlugin\Assigner\Property\Common\EnabledValueAssigner"/>
    </services>
</container>
