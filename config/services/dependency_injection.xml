<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag.sylius_ergonode_plugin.form_registry.resource_relation_mapping_types" class="Sylius\Bundle\ResourceBundle\Form\Registry\FormTypeRegistry"/>
        <service
            id="bitbag.ergonode_plugin.resource_relation_mapping_storage_registry"
            class="BitBag\SyliusErgonodePlugin\DependencyInjection\Registry\ResourceRelationMappingStorageRegistry"
            public="true"
        />

        <service id="bitbag.sylius_ergonode_plugin.resource_relation_mapping.registry" class="Sylius\Component\Registry\ServiceRegistry">
            <argument>%bitbag_ergonode.model.resource_relation_mapping.class%</argument>
            <argument>resource relation mapping type</argument>
        </service>
    </services>
</container>
