<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag.sylius_ergonode_plugin.synchronizer.category_synchronizer" class="BitBag\SyliusErgonodePlugin\Synchronizer\CategorySynchronizer">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.category_api_client"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.category_tree_leafs_codes_provider"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.taxon_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.taxon_values_assigner"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.factory.serializer_factory"/>
            <argument type="service" id="sylius.repository.taxon"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.resource_relation_mapping_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.property_value_assigner.taxon_parent_assigner"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.collector.deleted_categories_collector"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
<!--            <tag name="bitbag.sylius_ergonode_plugin.synchronizer" priority="1000"/>-->
        </service>

        <service id="bitbag.sylius_ergonode_plugin.synchronizer.attribute_synchronizer" class="BitBag\SyliusErgonodePlugin\Synchronizer\AttributeSynchronizer">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.attribute_api_client"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.attribute_provider"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="sylius.repository.product_attribute"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.resource_relation_mapping_resolver"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.attribute_values_assigner"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.collector.deleted_attributes_collector"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.updater.product_association_type_updater"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
<!--            <tag name="bitbag.sylius_ergonode_plugin.synchronizer" priority="800"/>-->
        </service>

        <service id="bitbag.sylius_ergonode_plugin.synchronizer.product_synchronizer" class="BitBag\SyliusErgonodePlugin\Synchronizer\ProductSynchronizer">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.product_api_client"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.product_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.provider.product_variant_provider"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product.product_values_assigner"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product_variant.product_variant_values_assigner"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.storage.variant_codes_storage"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
            <argument type="service" id="sylius.repository.product"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.collector.deleted_products_collector"/>
            <argument type="service" id="sylius.repository.product_variant"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product.product_associations_assigner"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product.product_taxons_assigner"/>
            <tag name="bitbag.sylius_ergonode_plugin.synchronizer" priority="600"/>
        </service>
    </services>
</container>
