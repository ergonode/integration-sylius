<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>

    <services>
        <service id="bitbag.sylius_ergonode_plugin.cli.synchronization_command" class="BitBag\SyliusErgonodePlugin\CLI\SynchronizationCommand">
            <argument type="service" id="bitbag_ergonode.repository.integration"/>
            <argument type="service" id="messenger.default_bus" />
            <argument type="service" id="bitbag.sylius_ergonode_plugin.logger.prefixed_logger"/>
            <tag name="console.command"/>
        </service>
    </services>
</container>
