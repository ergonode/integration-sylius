<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag.sylius_ergonode_plugin.menu.admin_menu_listener" class="BitBag\SyliusErgonodePlugin\Menu\AdminMenuListener">
        <argument>%env(resolve:ADMIN_MENU_ERGONODE_SECTION_POSITION)%</argument>
            <tag name="kernel.event_listener" event="sylius.menu.admin.main" method="addErgonodeSection"/>
        </service>
    </services>
</container>
