<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <parameters>
        <parameter key="bitbag.sylius_ergonode_plugin.form.type.resource_relation_mapping_type.validation_groups" type="collection">
            <parameter>sylius</parameter>
        </parameter>
        <parameter key="bitbag.sylius_ergonode_plugin.form.type.integration_type.validation_groups" type="collection">
            <parameter>sylius</parameter>
        </parameter>
    </parameters>

    <services>
        <service id="bitbag.sylius_ergonode_plugin.form.type.resource_relation_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Type\ResourceRelationMappingType">
            <argument>%bitbag_ergonode.model.resource_relation_mapping.class%</argument>
            <argument>%bitbag.sylius_ergonode_plugin.form.type.resource_relation_mapping_type.validation_groups%</argument>
            <tag name="form.type" />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.type.integration_autocomplete_type" class="BitBag\SyliusErgonodePlugin\Form\Type\IntegrationAutocompleteType" >
            <tag name="form.type" />
            <tag name="ux.entity_autocomplete_field" />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.type.integration_type" class="BitBag\SyliusErgonodePlugin\Form\Type\IntegrationType">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.encryptor.encryptor"/>
            <argument>%bitbag_ergonode.model.integration.class%</argument>
            <argument>%bitbag.sylius_ergonode_plugin.form.type.integration_type.validation_groups%</argument>
            <tag name="form.type" />
        </service>
    </services>
</container>
