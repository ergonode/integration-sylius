<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <parameters>
        <parameter key="bitbag.sylius_ergonode_plugin.form.type.resource_relation_mapping_type.validation_groups" type="collection">
            <parameter>sylius</parameter>
        </parameter>
        <parameter key="bitbag.sylius_ergonode_plugin.form.type.integration_type.validation_groups" type="collection">
            <parameter>sylius</parameter>
        </parameter>
    </parameters>

    <services>
        <service id="bitbag.sylius_ergonode_plugin.form.type.resource_relation_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Type\ResourceRelationMappingType">
            <argument>%bitbag_ergonode.model.resource_relation_mapping.class%</argument>
            <argument>%bitbag.sylius_ergonode_plugin.form.type.resource_relation_mapping_type.validation_groups%</argument>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.form_registry.resource_relation_mapping_types"/>
            <tag name="form.type" />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.type.integration_autocomplete_type" class="BitBag\SyliusErgonodePlugin\Form\Type\IntegrationAutocompleteType" >
            <tag name="form.type" />
            <tag name="ux.entity_autocomplete_field" />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.type.integration_type" class="BitBag\SyliusErgonodePlugin\Form\Type\IntegrationType">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.encryptor.encryptor"/>
            <argument type="service" id="sylius.repository.locale"/>
            <argument>%bitbag_ergonode.model.integration.class%</argument>
            <argument>%bitbag.sylius_ergonode_plugin.form.type.integration_type.validation_groups%</argument>
            <tag name="form.type" />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.attribute_property_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\AttributePropertyMappingType">
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="attribute_property"
                label="bitbag_ergonode.ui.relation_types.attribute_property"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.product_property_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\ProductPropertyMappingType">
            <argument type="service" id="sylius.repository.channel" />
            <tag name="form.type" />
            <tag name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="product_property"
                label="bitbag_ergonode.ui.relation_types.product_property"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.variant_property_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\ProductVariantPropertyMappingType">
            <argument type="service" id="sylius.repository.channel" />
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="variant_property"
                label="bitbag_ergonode.ui.relation_types.variant_property"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.category_property_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\CategoryPropertyMappingType">
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="category_property"
                label="bitbag_ergonode.ui.relation_types.category_property"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.product_external_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\ProductExternalMappingType">
            <argument type="service" id="sylius.repository.product" />
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="product_external_identifier"
                label="bitbag_ergonode.ui.relation_types.product_external_identifier"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.product_variant_external_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\ProductVariantExternalMappingType">
            <argument type="service" id="sylius.repository.product_variant" />
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="variant_external_identifier"
                label="bitbag_ergonode.ui.relation_types.variant_external_identifier"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.attribute_external_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\AttributeExternalMappingType">
            <argument type="service" id="sylius.repository.product_attribute" />
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="attribute_external_identifier"
                label="bitbag_ergonode.ui.relation_types.attribute_external_identifier"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.category_external_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\CategoryExternalMappingType">
            <argument type="service" id="sylius.repository.taxon" />
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="category_external_identifier"
                label="bitbag_ergonode.ui.relation_types.category_external_identifier"
            />
        </service>

        <service id="bitbag.sylius_ergonode_plugin.form.mapping.type.locale_external_mapping_type" class="BitBag\SyliusErgonodePlugin\Form\Mapping\Type\LocaleExternalMappingType">
            <argument type="service" id="sylius.repository.locale" />
            <tag name="form.type" />
            <tag
                name="bitbag.sylius_ergonode_plugin.resource_relation_mapping_type"
                type="locale_external_identifier"
                label="bitbag_ergonode.ui.relation_types.locale_external_identifier"
            />
        </service>
    </services>
</container>
