<?xml version="1.0" encoding="UTF-8"?>
<container
    xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="bitbag.sylius_ergonode_plugin.provider.category_tree_leafs_codes_provider" class="BitBag\SyliusErgonodePlugin\Provider\CategoryTreeLeafsCodesProvider">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.api.client.category_api_client"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.provider.taxon_provider" class="BitBag\SyliusErgonodePlugin\Provider\TaxonProvider">
            <argument type="service" id="sylius.repository.taxon"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.resource_relation_mapping_resolver"/>
            <argument type="service" id="sylius.custom_factory.taxon"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.provider.attribute_provider" class="BitBag\SyliusErgonodePlugin\Provider\AttributeProvider">
            <argument type="service" id="sylius.repository.product_attribute"/>
            <argument type="service" id="sylius.factory.product_attribute"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.resource_relation_mapping_resolver"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.provider.product_provider" class="BitBag\SyliusErgonodePlugin\Provider\ProductProvider">
            <argument type="service" id="sylius.repository.product"/>
            <argument type="service" id="sylius.custom_factory.product"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.resource_relation_mapping_resolver"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.provider.product_variant_provider" class="BitBag\SyliusErgonodePlugin\Provider\ProductVariantProvider">
            <argument type="service" id="sylius.repository.product_variant"/>
            <argument type="service" id="sylius.custom_factory.product_variant"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.resolver.resource_relation_mapping_resolver"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.provider.product_option_provider" class="BitBag\SyliusErgonodePlugin\Provider\ProductOptionProvider">
            <argument type="service" id="sylius.repository.product_option"/>
            <argument type="service" id="sylius.factory.product_option"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.assigner.product.product_option_name_assigner"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.provider.mapped_products_provider" class="BitBag\SyliusErgonodePlugin\Provider\MappedProductsProvider">
            <argument type="service" id="sylius.repository.product"/>
            <argument type="service" id="bitbag.sylius_ergonode_plugin.storage.products_relations_storage"/>
        </service>

        <service id="bitbag.sylius_ergonode_plugin.provider.product_association_provider" class="BitBag\SyliusErgonodePlugin\Provider\ProductAssociationProvider">
            <argument type="service" id="bitbag.sylius_ergonode_plugin.preloader.product_association_type_preloader"/>
            <argument type="service" id="sylius.factory.product_association"/>
            <argument type="service" id="doctrine.orm.entity_manager"/>
        </service>
    </services>
</container>
