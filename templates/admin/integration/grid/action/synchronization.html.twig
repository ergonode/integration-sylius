{% set path = path('bitbag_ergonode_admin_integration_synchronization', {'id': data.id}) %}
{% set label = 'bitbag_ergonode.ui.sync'|trans %}
{% set modal_id = 'modal-sync-' ~ data.id %}

{% component 'sylius_admin:confirmation_modal' with {modal_id: modal_id, type: 'synchronize'} %}
    {% import '@SyliusAdmin/shared/helper/button.html.twig' as button %}
    {% block trigger %}
        <div data-bs-toggle="tooltip" data-bs-title="{{ label }}" {{ sylius_test_html_attribute('trigger-button', label) }}>
            {{ button.default({
                icon: 'tabler:refresh',
                icon_class: 'icon',
                icon_only: true,
                attr: ' data-bs-toggle=modal data-bs-target=#' ~ modal_id,
            }) }}
        </div>
    {% endblock %}
    {% block footer %}
        <form action="{{ path }}" method="POST" name="sync_form">
            {{ button.default({ text: 'sylius.ui.cancel'|trans, attr: 'data-bs-dismiss=modal' }) }}
            {{ button.default({ text: label, type: 'submit', class: 'btn-primary', attr: sylius_test_html_attribute('confirm-button') }) }}
        </form>
    {% endblock %}
{% endcomponent %}
