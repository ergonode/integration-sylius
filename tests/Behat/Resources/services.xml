<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults public="true" />
        <!-- Put your Behat services here -->

        <service id="tests.bit_bag.sylius_ergonode_plugin.behat.context.ui.shop.welcome_context" class="Tests\BitBag\SyliusErgonodePlugin\Behat\Context\Ui\Shop\WelcomeContext">
            <argument type="service" id="tests.bit_bag.sylius_ergonode_plugin.behat.page.shop.static_welcome_page" />
            <argument type="service" id="tests.bit_bag.sylius_ergonode_plugin.behat.page.shop.dynamic_welcome_page" />
        </service>

        <service id="tests.bit_bag.sylius_ergonode_plugin.behat.page.shop.static_welcome_page" class="Tests\BitBag\SyliusErgonodePlugin\Behat\Page\Shop\StaticWelcomePage" parent="sylius.behat.symfony_page" public="false" />
        <service id="tests.bit_bag.sylius_ergonode_plugin.behat.page.shop.dynamic_welcome_page" class="Tests\BitBag\SyliusErgonodePlugin\Behat\Page\Shop\DynamicWelcomePage" parent="sylius.behat.symfony_page" public="false" />
    </services>
</container>
